{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Looper",
  "version": "0.1.0",
  "identifier": "com.naoki-tomita.looper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Looper",
        "width": 960,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Music",
    "shortDescription": "オーバーダブ型ルーパー",
    "longDescription": "マイク入力を複数トラックに重ね録りできる Mac/Linux 対応ルーパー"
  }
}
